# Every key here is optional. The service URLs and the Discord application id are
# compiled into the executable, and CI bakes in the ADS-B client token; these
# override them for development.
API_BASE_URL="https://api.flights.barcz.me"
ADSB_BASE_URL="https://adsb.barcz.me"
ADSB_CLIENT_TOKEN=""
DISCORD_APPLICATION_ID=""

# Reach MSFS on another machine (development from macOS).
# Leave unset on the pilot's PC to use the local SimConnect pipe.
SIMCONNECT_HOST=""
SIMCONNECT_PORT="500"

LOG_LEVEL="info"
