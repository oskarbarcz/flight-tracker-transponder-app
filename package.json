{
  "name": "flight-tracker-transponder-app",
  "version": "0.10.0",
  "private": true,
  "homepage": "https://mypreflight.io",
  "author": "oskarbarcz",
  "license": "Unlicense",
  "description": "The desktop companion app for MyPreflight platform.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:exe": "bun bin/build-exe.mjs",
    "build:icon": "node bin/make-icon.mjs",
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "preview": "node bin/preview.mjs",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "lint:ci": "biome ci src",
    "format:fix": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "node-simconnect": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
