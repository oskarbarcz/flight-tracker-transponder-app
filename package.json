{
  "name": "flight-tracker-transponder-app",
  "version": "0.1.0",
  "description": "Desktop companion feeding simulator positions to Flight Tracker and publishing Discord rich presence",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:exe": "bun build src/main.ts --compile --target=bun-windows-x64 --outfile dist/flight-tracker-transponder.exe",
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "lint:ci": "biome ci src",
    "format:fix": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "node-simconnect": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
